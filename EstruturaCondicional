        "print(\"Escolha uma opção dessas:\")\n",
        "print(\"A. Média ponderada (pesos 2 e 3)\")\n",
        "print(\"B. Quadrado da soma dos 2 números\")\n",
        "print(\"C. Cubo do menor número\")\n",
        "\n",
        "opcao = input(\"Opção: \").upper()\n",
        "\n",
        "if opcao == \"A\":\n",
        "    media = (num1 * 2 + num2 * 3) / 5\n",
        "    print(\"Média ponderada =\", media)\n",
        "\n",
        "elif opcao == \"B\":\n",
        "    resultado = (num1 + num2) ** 2\n",
        "    print(\"Quadrado da soma =\", resultado)\n",
        "\n",
        "elif opcao == \"C\":\n",
        "    menor = min(num1, num2)\n",
        "    resultado = menor ** 3\n",
        "    print(\"Cubo do menor número =\", resultado)\n",
        "\n",
        "else:\n",
        "    print(\"Opção inválida\")"
